<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="14" author="Ahmet_Calik">
        <comment>Create order_tracking table for shipment details</comment>
        <createTable tableName="order_tracking">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="order_id" type="BIGINT">
                <constraints nullable="false" unique="true" foreignKeyName="fk_tracking_order" references="orders(id)"/>
            </column>
            <column name="tracking_number" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="carrier_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_tracking_carrier" references="carrier(id)"/>
            </column>

            <column name="cdate" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="cuser" type="BIGINT"/>
            <column name="udate" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="uuser" type="BIGINT"/>
            <column name="version" type="BIGINT"/>
        </createTable>
    </changeSet>

</databaseChangeLog>